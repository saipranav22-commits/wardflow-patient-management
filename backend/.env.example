# WardFlow Backend Environment Variables

# Application Environment: 'development' | 'production' | 'test'
APP_ENV=development

# Database connection URL
# Local SQLite default:
DATABASE_URL=sqlite:///./patients.db
# Production Neon/PostgreSQL example:
# DATABASE_URL=postgresql://wardflow_user:password@ep-example-123456.us-east-2.aws.neon.tech/wardflow?sslmode=require

# Allowed CORS origins (comma-separated or JSON array)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Port
PORT=8000
